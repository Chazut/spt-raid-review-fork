<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>RaidReview</RootNamespace>
    <AssemblyName>RaidReview</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <Version>1.3.0</Version>
    <OutputPath>bin\$(Configuration)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Copy NuGet runtime deps to output folder -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- SPTarkov packages are already in the SPT server folder — don't copy them to the mod folder -->
    <PackageReference Include="SPTarkov.Common" Version="4.0.5" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.DI" Version="4.0.5" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.0.5" ExcludeAssets="runtime" />
    <!-- SQLite — cross-platform bundle (e_sqlite3 works on Windows + Linux) -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="9.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
  </ItemGroup>

  <!-- Embed the React frontend INTO the DLL (avoids .js files in the mod folder,
       which SPT's ModValidator.ValidMod() would reject as a legacy JS mod) -->
  <ItemGroup>
    <EmbeddedResource Include="public\**\*">
      <!-- LogicalName = "frontend/" + relative path — preserves directory structure without dots-as-separators ambiguity -->
      <LogicalName>frontend/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Deploy to SPT user/mods folder after build with clean structure. -->
  <Target Name="DeployToSpt" AfterTargets="Build">
    <ItemGroup>
      <SptInstall Include="C:\Games\SPT-4.0-hardcore\SPT\user\mods\RaidReview" Condition="Exists('C:\Games\SPT-4.0-hardcore\SPT\user\mods')" />
    </ItemGroup>
    <ItemGroup>
      <ModDlls Include="$(OutputPath)*.dll"
               Exclude="$(OutputPath)SPTarkov.*;$(OutputPath)SemanticVersioning.*;$(OutputPath)JetBrains.*" />
      <NativeSqlite Include="$(OutputPath)runtimes\win-x64\native\e_sqlite3.dll" Condition="Exists('$(OutputPath)runtimes\win-x64\native\e_sqlite3.dll')" />
    </ItemGroup>
    <MakeDir Directories="%(SptInstall.Identity);%(SptInstall.Identity)\config" />
    <Copy SourceFiles="@(ModDlls)" DestinationFolder="%(SptInstall.Identity)" SkipUnchangedFiles="true" />
    <MakeDir Directories="%(SptInstall.Identity)\runtimes\win-x64\native" Condition="@(NativeSqlite) != ''" />
    <Copy SourceFiles="@(NativeSqlite)" DestinationFolder="%(SptInstall.Identity)\runtimes\win-x64\native" SkipUnchangedFiles="true" />
    <Copy SourceFiles="config\config.json" DestinationFolder="%(SptInstall.Identity)\config" SkipUnchangedFiles="true" />
  </Target>

</Project>
